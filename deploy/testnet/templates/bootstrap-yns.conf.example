# TEMPLATE ONLY. Replace every placeholder before use.
# `yami-testnet init --mode public` generates a complete, validated profile;
# use init --yns --relay for the first public-test topology.
# The provider shares the bootstrap TLS identity/port; its state stays inside state/yns.
# This does not configure any official registry root or open a firewall.
yaminet-config 1
role node
network public
public-listen yes
identity /var/lib/yaminet/testnet/bootstrap/identity
state /var/lib/yaminet/testnet/bootstrap/state
site /var/lib/yaminet/testnet/bootstrap/site
listen BIND_IPV4:17444
advertise PUBLIC_IPV4:17444
dht yes
yns yes
workers 4
renew-secs 21600
health-secs 300
