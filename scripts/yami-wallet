#!/usr/bin/env python3
"""Encrypted local wallets. Development payments only; no production security activation."""
import argparse,getpass,json,os,pathlib,subprocess,sys,runpy
ROOT=pathlib.Path(__file__).resolve().parents[1]
BINARY=ROOT/'experiments/yamichain-tee-m20/target/release/wallet-vault'
def password():
 if 'YAMI_WALLET_PASSWORD_FILE' in os.environ:
  path=pathlib.Path(os.environ['YAMI_WALLET_PASSWORD_FILE'])
  if path.stat().st_mode&0o077:raise SystemExit('password file must have mode 0600')
  return path.read_text().removesuffix('\n')
 return getpass.getpass('Wallet password: ')
def native(value):
 p=subprocess.run([str(BINARY)],input=json.dumps(value),text=True,capture_output=True)
 if p.returncode:raise SystemExit(p.stderr.strip())
 return json.loads(p.stdout)
def save(path,value):
 fd=os.open(path,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
 with os.fdopen(fd,'w') as f:json.dump(value,f);f.flush();os.fsync(f.fileno())
 fd=os.open(pathlib.Path(path).parent,os.O_RDONLY);os.fsync(fd);os.close(fd)
p=argparse.ArgumentParser(description=__doc__)
p.add_argument('--network',choices=['native','economics'],default='economics')
p.add_argument('command',choices=['create','encrypt','backup','restore','address','balance','send','fee','validator-key','register','stake','unstake','withdraw','exit','status','verify'])
p.add_argument('args',nargs='*');a=p.parse_args()
if a.command=='create':
 secret=password()
 if 'YAMI_WALLET_PASSWORD_FILE' not in os.environ and getpass.getpass('Confirm wallet password: ')!=secret:raise SystemExit('passwords do not match')
 value=native(dict(op='create',password=secret));save(a.args[0],value);print(value['address'])
elif a.command=='encrypt':
 value=json.loads(pathlib.Path(a.args[0]).read_text())
 if 'secret' not in value:raise SystemExit('legacy plaintext wallet required; use backup for encrypted wallets')
 sealed=native(dict(op='import',password=password(),secret=value['secret']))
 if sealed['address']!=value['address']:raise SystemExit('legacy wallet address mismatch')
 save(a.args[1],sealed);print(sealed['address'])
elif a.command in ('backup','restore'):

 value=json.loads(pathlib.Path(a.args[0]).read_text())
 if 'ciphertext' not in value:raise SystemExit('encrypt legacy wallets before backup; plaintext key export is refused')
 native(dict(op='unlock',password=password(),vault=value))
 save(a.args[1],value);print('Encrypted wallet copied; keep the password separately')
elif a.command=='address':
 print(json.loads(pathlib.Path(a.args[0]).read_text())['address'])
elif a.command=='verify':
 if a.network=='economics':
  os.environ.setdefault('YAMI_DEVNET_CONFIG',str(ROOT/'docs/devnet/economics-network.json'))
  os.environ.setdefault('YAMI_DEVNET_DIR',str(ROOT/'work/yamichain-economics-devnet'))
 d=runpy.run_path(str(ROOT/'scripts/yamichain-devnet'))
 height=int(a.args[0]);policy=d['policy']()
 records=[d['http'](d['URL']+'/history/'+str(h))['finality']['record'] for h in range(1,height+1)]
 verified=d['bridge']('audit-native',policy=policy,records=records)
 history=d['http'](d['URL']+'/history/'+str(height))
 certificate=d['bridge']('finality',record=history['finality']['record'],height=height,certificate=history['certificate'],policy=policy)
 print(json.dumps(dict(verified=True,height=verified['height'],block=certificate['block'],production_security=False)))
else:
 command=ROOT/('scripts/yamichain-economic-devnet' if a.network=='economics' else 'scripts/yamichain-devnet')
 os.execv(str(command),[str(command),a.command,*a.args])
