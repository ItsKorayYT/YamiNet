#!/usr/bin/env python3
"""Live disposable-stake Malachite lifecycle, recovery and objective slashing."""
import json,os,pathlib,signal,subprocess,time,urllib.request,sys
ROOT=pathlib.Path(__file__).resolve().parents[1]
CLI=ROOT/'scripts/yamichain-pos-devnet'
DATA=pathlib.Path(os.environ.get('YAMI_DEVNET_DIR',ROOT/'work/yamichain-pos-devnet'))
sys.path.insert(0,str(ROOT/'tools'))
from yamichain_rpc import Transport
CONFIG=json.loads(pathlib.Path(os.environ.get('YAMI_DEVNET_CONFIG',ROOT/'docs/devnet/pos-network.json')).read_text())
URL=CONFIG['gateway']
RPC=Transport(CONFIG.get('rpc'),{'gateway':[URL]})
WALLETS=pathlib.Path(os.environ.get('YAMI_POS_SMOKE_WALLET_DIR',ROOT/'work')).resolve()
WALLETS.mkdir(mode=0o700,parents=True,exist_ok=True)
BRIDGE=ROOT/'experiments/yamichain-tee-m20/target/release/devnet-bridge'
def run(*args,success=True):
 p=subprocess.run([str(CLI),*map(str,args)],capture_output=True,text=True)
 if success and p.returncode:raise RuntimeError(p.stderr)
 if not success:
  assert p.returncode,'hostile operation accepted'
  return
 return p.stdout.strip()
def get(path='/status'):
 return RPC.request(URL+path,timeout=15)
def bridge(op,success=True,**kw):
 p=subprocess.run([str(BRIDGE)],input=json.dumps(dict(op=op,**kw)),capture_output=True,text=True)
 if not success:
  assert p.returncode,'invalid history accepted'
  return
 if p.returncode:raise RuntimeError(p.stderr)
 return json.loads(p.stdout)
def wait_record(slot,height,timeout=60):
 end=time.monotonic()+timeout
 p=DATA/f'validator-{slot}/native-finalized-{height}.bin'
 while time.monotonic()<end:
  if p.exists():return list(p.read_bytes())
  time.sleep(.2)
 raise RuntimeError(f'validator {slot} did not synchronize to {height}')
run('start')
assert get()['height']==0,'use a fresh dedicated PoS ledger'
wallet=WALLETS/'pos-operator.wallet';other=WALLETS/'pos-recipient.wallet';key=WALLETS/'pos-operator.validator'
run('wallet',wallet);run('wallet',other);validator=run('validator-key',key)
run('faucet',wallet,1000)
run('register',wallet,key)
run('stake',wallet,validator,200)
assert json.loads(run('balance',wallet))['portfolio']['bonded']==200
run('join-validator',key,4)
wait_record(4,get()['height'])
joined=None;earned=None;signed=None
for _ in range(100):
 committee=get('/committee')
 before=json.loads(run('balance',wallet))['balance']
 receipt=json.loads(run('faucet',other,1))
 if validator in committee['members']:
  joined=joined or committee['height']
  after=json.loads(run('balance',wallet))['balance']
  if after>before:earned={'height':receipt['height'],'amount':after-before}
  final=get('/history/'+str(receipt['height']))['finality']
  if validator in final['signers']:signed=receipt['height']
 if earned and signed:break
assert joined and earned and signed,'candidate must earn and sign as a live committee member'
# Crash the candidate, preserve its journal/WAL/signing reservations, and let its
# existing service restart it. This exercises replay across a committee change.
pid=json.loads((DATA/'consensus-4.pid').read_text());os.kill(pid,signal.SIGSTOP)
for _ in range(8):run('faucet',other,1)
os.kill(pid,signal.SIGKILL)
end=time.monotonic()+30
while time.monotonic()<end:
 new_pid=json.loads((DATA/'consensus-4.pid').read_text())
 if new_pid!=pid:break
 time.sleep(.2)
assert new_pid!=pid
# Keep making native transitions until candidate has a fresh signed block.
for _ in range(30):
 r=json.loads(run('faucet',other,1));wait_record(4,r['height'])
 if validator in get('/history/'+str(r['height']))['finality']['signers']:
  signed=r['height'];break
else:raise RuntimeError('restarted candidate did not sign')
records=[get('/history/'+str(h))['finality']['record'] for h in range(1,signed+1)]
fixture=bridge('devnet-double-vote-fixture',policy=get('/policy'),records=records,secret=json.loads(key.read_text())['consensus_secret'],height=signed)
left=WALLETS/'pos-double-vote-a.bin';right=WALLETS/'pos-double-vote-b.bin'
left.write_bytes(bytes(fixture['left']));right.write_bytes(bytes(fixture['right']))
run('exit',wallet,validator)
unbond=json.loads(run('unstake',wallet,validator,200));ticket=unbond['withdrawal_ticket']
run('withdraw',wallet,ticket,success=False)
run('slash',wallet,left,right)
portfolio=json.loads(run('balance',wallet))['portfolio'];assert portfolio['unbonding']==100
before=get()['head'];run('slash',wallet,right,left,success=False);assert get()['head']==before
unlock=portfolio['withdrawals'][0]['unlock']
while get()['height']<unlock:run('faucet',other,1)
assert validator not in get('/committee')['members']
run('withdraw',wallet,ticket)
run('withdraw',wallet,ticket,success=False)
final=get();balance=json.loads(run('balance',wallet))
run('stop');run('start');assert get()['head']==final['head']
assert json.loads(run('balance',wallet))==balance
for slot in range(5):wait_record(slot,final['height'])
# A valid speculative boundary proposal must not install future signer authority.
prior=[get('/history/'+str(h))['finality']['record'] for h in range(1,6)]
speculative=bridge('audit-native',policy=get('/policy'),records=prior,candidate=get('/history/6')['certificate'])
assert speculative['candidate_accepted'] and speculative['state_unchanged'] and not speculative['future_committee_installed']
# Independently replay the public history from the pinned bootstrap.
records=[get('/history/'+str(h))['finality']['record'] for h in range(1,final['height']+1)]
audit=bridge('audit-native',policy=get('/policy'),records=records)
assert audit['height']==final['height']
gapped=records.copy();gapped.pop(5)
bridge('audit-native',success=False,policy=get('/policy'),records=gapped)
for h in range(1,final['height']+1):
 raw=json.dumps(get('/history/'+str(h))['certificate'])
 assert all(word not in raw for word in ('sender','recipient','amount','balance','portfolio'))
print(json.dumps(dict(software_only=True,production_activation=False,live_pos=True,registered=validator,joined_height=joined,earned=earned,signed_height=signed,candidate_crash_recovered=True,lag_across_epoch_recovered=True,slash_unbonding_penalty=100,replayed_evidence_rejected=True,left_safely=True,withdrawal_after_unlock=unlock,restart_preserved=True,history_verified=audit['height'],gapped_history_rejected=True,final_height=final['height'],final_balance=balance),indent=2))
