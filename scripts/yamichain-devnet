#!/usr/bin/env python3
"""INSECURE SOFTWARE DEVNET. Disposable YAMI only. Never production custody."""
import argparse
import atexit
import fcntl
import json
import os
import pathlib
import signal
import subprocess
import sys
import time
import threading
import urllib.request


ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'tools'))
from yamichain_rpc import Transport, Handler as RpcHandler
from yamichain_services import Services
from yamichain_worker_io import exchange

DATA = pathlib.Path(os.environ.get('YAMI_DEVNET_DIR', ROOT / 'work/yamichain-native-devnet')).resolve()
BIN = ROOT / 'experiments/yamichain-tee-m20/target/release'
CARGO = os.environ.get('CARGO', '/workspace/.yami-tools/cargo/bin/cargo' if pathlib.Path('/workspace/.yami-tools/cargo/bin/cargo').exists() else 'cargo')
if pathlib.Path('/workspace/.yami-tools/cargo').exists():
    os.environ.setdefault('CARGO_HOME', '/workspace/.yami-tools/cargo')
    os.environ.setdefault('RUSTUP_HOME', '/workspace/.yami-tools/rustup')
WARNING = 'INSECURE SOFTWARE DEVNET; TEST YAMI ONLY; NO HARDWARE PROTECTION'
children = []
role = ''
index = 0


def read(path):
    return json.loads(pathlib.Path(path).read_text())


def save(path, value):
    path = pathlib.Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix('.tmp')
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        json.dump(value, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    fd = os.open(path.parent, os.O_RDONLY)
    os.fsync(fd)
    os.close(fd)


CONFIG = read(os.environ['YAMI_DEVNET_CONFIG']) if 'YAMI_DEVNET_CONFIG' in os.environ else {}
URL = os.environ.get('YAMI_DEVNET_URL', CONFIG.get('gateway', 'http://127.0.0.1:28780'))
EXECUTORS = CONFIG.get('executors', [f'http://127.0.0.1:{28790+i}' for i in range(4)])
VALIDATORS = CONFIG.get('validators', [f'http://127.0.0.1:{28890+i}' for i in range(4)])
WITNESSES = CONFIG.get('witnesses', [f'127.0.0.1:{28800+i}' for i in range(4)])
PEERS = CONFIG.get('validator_peers', [f'127.0.0.1:{28900+i}' for i in range(4)])
LIVE_POS=bool((CONFIG.get('economics') or {}).get('live_pos',False))
if len(EXECUTORS)!=4 or len(WITNESSES)!=4 or len(VALIDATORS)!=len(PEERS) or not 4<=len(PEERS)<=100:
    raise SystemExit('four executor/witness endpoints and 4..100 matching validator/peer slots required')


RPC = Transport(CONFIG.get('rpc'), {'gateway':[URL], 'executor':EXECUTORS, 'validator':VALIDATORS})

def bridge(op, **kw):
    p = subprocess.run([str(BIN / 'devnet-bridge')], input=json.dumps(dict(op=op, **kw)), text=True, capture_output=True)
    if p.returncode:
        raise RuntimeError(p.stderr.strip())
    return json.loads(p.stdout)


_wallet_cache={}
def wallet_secret(path):
    value=read(path)
    if 'ciphertext' not in value:return value['secret']
    key=str(pathlib.Path(path).resolve())
    if key not in _wallet_cache:
        if 'YAMI_WALLET_PASSWORD_FILE' in os.environ:
            source=pathlib.Path(os.environ['YAMI_WALLET_PASSWORD_FILE'])
            if source.stat().st_mode&0o077:raise RuntimeError('password file must have mode 0600')
            password=source.read_text().removesuffix('\n')
        else:
            import getpass
            password=getpass.getpass('Wallet password: ')
        p=subprocess.run([str(BIN/'wallet-vault')],input=json.dumps(dict(op='unlock',password=password,vault=value)),capture_output=True,text=True)
        if p.returncode:raise RuntimeError(p.stderr.strip())
        _wallet_cache[key]=json.loads(p.stdout)['secret']
    return _wallet_cache[key]


def http(url, value=None, timeout=90):
    return RPC.request(url, value, timeout)


def worker(i, command):
    return http(EXECUTORS[i], command, timeout=10)


def wait(url):
    for _ in range(600):
        try:
            return http(url, timeout=2)
        except Exception:
            time.sleep(.1)
    raise RuntimeError('unreachable ' + url)


def child_args(args):
    return [sys.executable,str(ROOT/'tools/yamichain_child.py'),str(os.getpid()),*map(str,args)]


def startchild(args, name, env=None):
    children[:]=[p for p in children if p.poll() is None]
    f = open(DATA / (name + '.log'), 'a')
    p = subprocess.Popen(child_args(args), stdout=f, stderr=f, env=env)
    children.append(p)
    save(DATA / (name + '.pid'), p.pid)
    return p


def own(command, i=None):
    args = [sys.executable, str(pathlib.Path(__file__).resolve()), command]
    return args if i is None else args + [str(i)]


def bootstrap():
    if (DATA / 'policy.json').exists():
        pinned=read(DATA/'economic-policy.json') if (DATA/'economic-policy.json').exists() else None
        if read(DATA/'policy.json')['committee']['chain']!=CONFIG.get('chain',24):raise RuntimeError('chain ID is pinned at genesis')
        if pinned!=CONFIG.get('economics'):raise RuntimeError('economic policy is pinned at genesis; choose a new devnet directory')
        expected=CONFIG.get('witness_tls') or {}
        for i in range(4):
            if read(DATA/f'witness-{i}.json').get('tls')!=expected.get('server') or read(DATA/f'executor-{i}.json').get('witness_tls')!=expected.get('client'):
                raise RuntimeError('witness TLS configuration differs from the retained service configs; refuse a silent transport downgrade')
        return
    treasury = bridge('key')
    save(DATA / 'treasury.wallet', treasury)
    keys = [bridge('key') for _ in range(4)]
    auth = [bridge('key') for _ in range(4)]
    observer = bridge('key')
    root = list(os.urandom(32))
    allocations = [(list(bytes.fromhex(treasury['address'])), 1_000_000_000_000)]
    committee = {'chain': CONFIG.get('chain',24), 'members': [{'signing': list(bytes.fromhex(k['address'])), 'transport': k['transport_public']} for k in keys]}
    genesis = bridge('genesis', allocations=allocations, root=root, economics=CONFIG.get('economics'), chain=committee['chain'])
    policy = dict(committee=committee, genesis=genesis, authorities=[list(bytes.fromhex(k['address'])) for k in auth], observer=list(bytes.fromhex(observer['address'])))
    if LIVE_POS:policy['native_scope']=bridge('pos-scope',allocations=allocations,economics=CONFIG['economics'],chain=committee['chain'])
    for i in range(4):
        witness_tls=CONFIG.get('witness_tls') or {}
        save(DATA / f'witness-{i}.json', dict(listen=WITNESSES[i], database=str(DATA / f'witness-{i}.sqlite'), policy=policy, index=i, signing_secret=auth[i]['secret'],tls=witness_tls.get('server')))
        save(DATA / f'executor-{i}.json', dict(snapshot=str(DATA / f'executor-{i}.state'), policy=policy, index=i, authority=WITNESSES[i], signing_secret=keys[i]['secret'], transport_secret=keys[i]['transport'], storage_secret=list(os.urandom(32)), root_secret=root, software_protocol_only=True, economics=CONFIG.get('economics'),witness_tls=witness_tls.get('client')))
    save(DATA / 'allocations.json', allocations)
    save(DATA / 'state.json', dict(head=genesis, height=0))
    save(DATA / 'economic-policy.json', CONFIG.get('economics'))
    save(DATA / 'policy.json', policy)


def history_records(height):
    return [read(DATA/f'receipt-{h}.json')['finality']['record'] for h in range(1,height+1)]


def finalize(pending):
    qc, height = pending['certificate'], pending['height']
    # Persist requests before transmission; retries always carry the same complete certificate.
    for endpoint in VALIDATORS:
        try:
            http(endpoint + '/propose/' + str(height), {'payload': pending['payload']}, timeout=2)
        except Exception:
            pass
    receipts = []
    end = time.monotonic() + 90
    while time.monotonic() < end:
        receipts = []
        for endpoint in VALIDATORS:
            try:
                raw = http(endpoint + '/record/' + str(height), timeout=2)
                receipts.append(bridge('finality', record=raw, height=height, certificate=qc, policy=read(DATA / 'policy.json'), records=history_records(height-1) if LIVE_POS else None))
            except Exception:
                pass
        # One authentic >2/3 Malachite commit establishes finality; require three durable archives for this devnet.
        if len(receipts) >= 3:
            break
        time.sleep(.25)
    if len(receipts) < 3 or len({r['block'] for r in receipts}) != 1:
        raise RuntimeError('native consensus finality unavailable; durable pending request retained')
    # Signer subsets/order may differ for the same authenticated transition. Commit
    # the exact complete certificate retained in the finalized native block.
    qc=receipts[0]['certificate']
    committed = 0
    for i in range(4):
        try:
            if worker(i, {'Commit': qc}) == 'Committed':
                committed += 1
        except Exception:
            pass
    if committed < 3:
        raise RuntimeError('insufficient durable executor commits; retry/restart to recover')
    receipt = dict(certificate=qc, finality=receipts[0])
    state = dict(head=qc['certificate']['statement']['next'], height=height,
                 finality={k: v for k, v in receipts[0].items() if k not in ('certificate', 'record')}, insecure=True)
    save(DATA / f'receipt-{height}.json', receipt)
    save(DATA / 'state.json', state)
    (DATA / 'pending.json').unlink(missing_ok=True)
    return state


def validator_start(i):
    directory = DATA / f'validator-{i}'
    directory.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, YAMI_NATIVE_POLICY=str(DATA / 'policy.json'), YAMI_NATIVE_VALIDATOR_ENDPOINTS=','.join(PEERS))
    keys=DATA/f'validator-key-{i}.bin'
    if keys.exists():env['YAMI_NATIVE_KEYS']=str(keys)
    return startchild([os.environ.get('YAMI_VALIDATOR_BINARY',str(ROOT / 'target/release/yami-validator')), 'run', '--dir', str(directory), '--index', str(i),
                       '--base-port', '28900', '--height', str(2**64-1), '--timeout', '3600'], f'consensus-{i}', env=env)


def listen(url):
    from urllib.parse import urlparse
    u = urlparse(url)
    return u.hostname, u.port


class Handler(RpcHandler):
    def handle_request(self, value):
        try:
            if role == 'validator':
                if proc.poll() is not None:
                    raise RuntimeError('consensus process stopped')
                if self.path.startswith('/record/') and value is None:
                    height = int(self.path.rsplit('/', 1)[1])
                    result = list((DATA / f'validator-{index}/native-finalized-{height}.bin').read_bytes())
                elif self.path.startswith('/propose/') and value is not None:
                    height = int(self.path.rsplit('/', 1)[1])
                    if height < 1 or len(value['payload']) > 30000:
                        raise RuntimeError('invalid submission')
                    payload = bytes(value['payload'])
                    # Only data availability here; the Rust State execution verifies every approval and witness.
                    json.loads(payload)
                    previous=None
                    if height>1:
                        previous=list((DATA/f'validator-{index}/native-finalized-{height-1}.bin').read_bytes())
                    bridge('validate-certificate',payload=list(payload),policy=read(DATA/'policy.json'),height=height,previous_record=previous,records=history_records(height-1) if LIVE_POS else None)
                    p = DATA / f'validator-{index}/devnet-payment-{height}.json'
                    if p.exists() and p.read_bytes() != payload:
                        raise RuntimeError('conflicting queued certificate')
                    if not p.exists():
                        tmp = p.with_suffix('.tmp')
                        with open(tmp, 'wb') as f:
                            f.write(payload)
                            f.flush()
                            os.fsync(f.fileno())
                        os.replace(tmp, p)
                    result = {'queued': height, 'insecure': True}
                else:
                    result = {'validator': index, 'consensus_pid': proc.pid, 'insecure': True}
            elif role == 'executor':
                result = exchange(proc, 'Head' if value is None else value)
                health_key='SyncStatus' if value=='SyncStatus' else 'Head'
                if (value is None or value=='Head' or value=='SyncStatus') and (not isinstance(result, dict) or health_key not in result):
                    # Includes an uncertain mutation/ACK: reopen from the same
                    # live authority instead of leaving a poisoned worker stuck.
                    proc.terminate()
                    raise RuntimeError('executor/witness not ready')
            elif self.path == '/committee' and value is None:
                result=bridge('live-committee',policy=read(DATA/'policy.json'),records=history_records(read(DATA/'state.json')['height']))
            elif self.path == '/recovery' and value is None:
                result=read(DATA/'recovery-status.json')
            elif self.path == '/services' and value is None:
                result=read(DATA/'services.json')
            elif self.path == '/fees' and value is None:
                result=read(DATA/'economic-policy.json') if (DATA/'economic-policy.json').exists() else None
            elif self.path == '/policy' and value is None:
                result = read(DATA / 'policy.json')
            elif self.path.startswith('/history/') and value is None:
                result = read(DATA / f'receipt-{int(self.path.rsplit("/", 1)[1])}.json')
            elif value is None:
                state = read(DATA / 'state.json')
                healthy = 0
                for i in range(4):
                    try:
                        healthy += worker(i, 'Head').get('Head') == state['head']
                    except Exception:
                        pass
                if healthy < 3:
                    raise RuntimeError('fewer than three synchronized executors')
                validators = []
                for endpoint in VALIDATORS:
                    try:
                        validators.append(http(endpoint, timeout=2))
                    except Exception:
                        pass
                if len(validators) < 3:
                    raise RuntimeError('fewer than three live consensus validators')
                result = dict(state, healthy_executors=healthy, healthy_validators=len(validators),
                              validators=validators, warning=WARNING, endpoint=URL)
            elif self.path == '/query':
                result = []
                for i, e in enumerate(value['envelopes']):
                    try:
                        result.append(worker(i, {'Query': e}))
                    except Exception:
                        pass
            elif self.path == '/send':
                if (DATA / 'pending.json').exists():
                    finalize(read(DATA / 'pending.json'))
                state = read(DATA / 'state.json')
                votes = []
                for i in range(4):
                    try:
                        r = worker(i, {'Prepare': value})
                    except Exception:
                        continue
                    if isinstance(r, dict) and 'Approval' in r:
                        votes.append(r['Approval'])
                c = bridge('certificate', policy=read(DATA / 'policy.json'), head=state['head'], votes=votes)
                pending = dict(c, height=state['height'] + 1)
                save(DATA / 'pending.json', pending)
                result = finalize(pending)
            else:
                raise RuntimeError('unknown endpoint')
            data = json.dumps(result).encode()
            self.send_response(200)
        except Exception as e:
            data = json.dumps({'error': str(e), 'insecure': True}).encode()
            self.send_response(503)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def policy():
    # Remote wallets pin policy.json on first use; subsequent identity changes fail closed.
    remote = http(URL + '/policy')
    pin = DATA / 'policy.json'
    if pin.exists() and read(pin) != remote:
        raise RuntimeError('pinned committee/witness policy mismatch')
    if not pin.exists():
        save(pin, remote)
    return remote


def balance(wallet):
    w, p = read(wallet), policy()
    state = http(URL)
    q = bridge('query', secret=wallet_secret(wallet), head=state['head'], policy=p)
    responses = http(URL + '/query', {'envelopes': q['envelopes']})
    replies = [r['Balance'] for r in responses if isinstance(r, dict) and 'Balance' in r]
    return bridge('balance', policy=p, query=q['query'], secret=q['secret'], replies=replies)


def fee_estimate(action='Transfer'):
    policy=http(URL+'/fees')
    if not policy:return {'fee':0,'units':1,'economics_enabled':False}
    units={'Transfer':1,'Register':4,'Bond':2,'Unbond':2,'Withdraw':1,'Exit':1,'Slash':4}[action]
    return {'fee':policy['base_fee']+policy['unit_fee']*units,'units':units,'economics_enabled':True}


def send(wallet, address, amount, action='Transfer'):
    b=balance(wallet)
    name=action if isinstance(action,str) else next(iter(action))
    estimate=fee_estimate(name)
    finance={'fee_limit':estimate['fee'],'action':action} if estimate['economics_enabled'] else None
    if finance is None and name!='Transfer':raise RuntimeError('staking requires an economics-enabled genesis')
    p=bridge('payment',policy=policy(),head=http(URL)['head'],secret=wallet_secret(wallet),recipient=address,amount=amount,nonce=b['nonce'],finance=finance)
    result=http(URL+'/send',p,timeout=120)
    result['fee']=estimate['fee']
    if name=='Unbond':result['withdrawal_ticket']=b['nonce']
    return result


def cleanup():
    for p in children:
        p.terminate()
    for p in children:
        try:
            p.wait(timeout=5)
        except subprocess.TimeoutExpired:
            p.kill()


def shutdown(*_):
    cleanup()
    sys.exit(0)


atexit.register(cleanup)


def recover():
    if (DATA / 'pending.json').exists():
        finalize(read(DATA / 'pending.json'))
    state = read(DATA / 'state.json')
    heads = []
    for i in range(4):
        try:
            heads.append(worker(i, 'Head')['Head'])
        except Exception:
            heads.append(None)
    for i, h in enumerate(heads):
        if h is not None and h != state['head']:
            source = next(j for j, v in enumerate(heads) if v == state['head'])
            progress=worker(i,'SyncStatus')['SyncStatus']['recovery']
            path=DATA/f'executor-recovery-{i}.json'
            bundle=read(path) if path.exists() else None
            if bundle is None or (progress and bundle['certificate']['certificate']['statement']['next']['epoch']<progress['target']['epoch']):
                # Ciphertext only, recipient-bound. This file grants no authority:
                # the recipient's witness must verify the entire missing prefix.
                bundle=worker(source,{'ExportState':i})['Recovery']
                save(path,bundle)
            target=bundle['certificate']['certificate']['statement']['next']
            cursor=progress['certificate']['certificate']['statement']['next'] if progress else h
            # Bound each supervision pass; the authority retains acknowledged
            # progress across wrapper/witness/coordinator restarts. No partial
            # prefix ever becomes the installed ledger or signs a new vote.
            for _ in range(2):
                if cursor==target:break
                page=worker(source,{'ExportHistory':{'after':cursor,'through':target}})['HistoryPage']
                if worker(i,{'StageHistory':page})!='Committed':
                    raise RuntimeError('executor history staging failed')
                progress=worker(i,'SyncStatus')['SyncStatus']['recovery']
                cursor=progress['certificate']['certificate']['statement']['next']
            if cursor==target:
                if worker(i, {'Recover': bundle}) != 'Committed':
                    raise RuntimeError('executor recovery failed')
                heads[i]=worker(i,'Head')['Head']
                path.unlink(missing_ok=True)
    return sum(h==state['head'] for h in heads)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['start', 'stop', 'status', 'wallet', 'faucet', 'send', 'balance', 'history', 'supervise', 'executor', 'witness', 'validator', 'gateway', 'bootstrap', 'fee', 'validator-key', 'register', 'stake', 'unstake', 'withdraw', 'exit', 'join-validator', 'slash'])
    parser.add_argument('args', nargs='*')
    a = parser.parse_args()
    DATA.mkdir(parents=True, exist_ok=True)
    os.chmod(DATA, 0o700)
    if a.command not in ('executor', 'supervise', 'validator', 'witness', 'gateway'):
        print(WARNING, file=sys.stderr)
    if a.command == 'start':
        try:
            print(json.dumps(http(URL, timeout=2)))
            sys.exit(0)
        except Exception:
            pass
        subprocess.run([CARGO, 'build', '--release', '--manifest-path', str(ROOT / 'experiments/yamichain-tee-m20/Cargo.toml'), '--bin', 'devnet-bridge', '--bin', 'witness-node', '--bin', 'witnessed-worker', '--bin', 'wallet-vault'], check=True)
        subprocess.run([CARGO, 'build', '--release', '-p', 'yami-validator', '--features', 'insecure-devnet-input'], cwd=ROOT, check=True)
        f = open(DATA / 'supervisor.log', 'a')
        p = subprocess.Popen(own('supervise'), stdout=f, stderr=f, start_new_session=True)
        print(json.dumps(wait(URL)))
    elif a.command == 'bootstrap':
        bootstrap()
        print('Provisioned ' + str(DATA))
    elif a.command == 'supervise':
        role = 'gateway'
        manager=Services()
        lock = open(DATA / 'supervisor.lock', 'w')
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        save(DATA/'supervisor.pid',os.getpid())
        bootstrap()
        signal.signal(signal.SIGTERM, shutdown)
        for i in range(4):
            manager.add(f'witness-{i}',lambda i=i:startchild([str(BIN / 'witness-node'), str(DATA / f'witness-{i}.json')], f'witness-{i}'))
        time.sleep(.5)
        for i in range(4):
            if not (DATA / f'executor-{i}.state').exists():
                bridge('init', config=read(DATA / f'executor-{i}.json'), allocations=read(DATA / 'allocations.json'))
            manager.add(f'executor-{i}',lambda i=i:startchild(own('executor', i), f'executor-{i}'))
            wait(EXECUTORS[i])
        for i in range(4):
            manager.add(f'validator-{i}',lambda i=i:startchild(own('validator', i), f'validator-{i}'))
            wait(VALIDATORS[i])
        for i in range(4,len(VALIDATORS)):
            if (DATA/f'validator-key-{i}.bin').exists():
                manager.add(f'validator-{i}',lambda i=i:startchild(own('validator',i),f'validator-{i}'));wait(VALIDATORS[i])
        recover()
        server=RPC.server(URL, Handler);server.timeout=1
        save(DATA/'services.json',manager.status())
        def recovery_monitor():
            while True:
                try:
                    with server.service_lock:healthy=recover()
                    save(DATA/'recovery-status.json',dict(ok=healthy>=3,healthy_executors=healthy,checked_at=int(time.time())))
                except Exception:
                    # Diagnostic state grants no restore or signing authority.
                    save(DATA/'recovery-status.json',dict(ok=False,checked_at=int(time.time())))
                time.sleep(5)
        threading.Thread(target=recovery_monitor,daemon=True).start()
        launched={i for i in range(len(VALIDATORS)) if i<4 or (DATA/f'validator-key-{i}.bin').exists()}
        while True:
            server.handle_request()
            manager.tick()
            save(DATA/'services.json',manager.status())
            for i in range(4,len(VALIDATORS)):
                if i not in launched and (DATA/f'validator-key-{i}.bin').exists():
                    manager.add(f'validator-{i}',lambda i=i:startchild(own('validator',i),f'validator-{i}'))
                    launched.add(i)
    elif a.command in ('executor', 'validator', 'witness'):
        role, index = a.command, int(a.args[0])
        if role == 'witness':
            os.execv(str(BIN / 'witness-node'), [str(BIN / 'witness-node'), str(DATA / f'witness-{index}.json')])
        if role == 'executor':
            if not (DATA / f'executor-{index}.state').exists():
                bridge('init', config=read(DATA / f'executor-{index}.json'), allocations=read(DATA / 'allocations.json'))
            proc = subprocess.Popen(child_args([str(BIN / 'witnessed-worker'), str(DATA / f'executor-{index}.json')]), stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True)
            children.append(proc)
        else:
            proc = validator_start(index)
        signal.signal(signal.SIGTERM, shutdown)
        server=RPC.server(EXECUTORS[index] if role == 'executor' else VALIDATORS[index], Handler)
        server.timeout=1
        delay=1;next_restart=0
        while True:
            server.handle_request()
            if proc.poll() is not None and time.monotonic()>=next_restart:
                # Reopen the SAME durable journal, WAL and signing reservations.
                # Storage/configuration refusal remains fail-closed; never recreate safety state.
                next_restart=time.monotonic()+delay;delay=min(delay*2,60)
                if role=='validator':proc=validator_start(index)
                else:
                    proc.stdin.close();proc.stdout.close()
                    children[:]=[p for p in children if p.poll() is None]
                    proc=subprocess.Popen(child_args([str(BIN/'witnessed-worker'),str(DATA/f'executor-{index}.json')]),stdin=subprocess.PIPE,stdout=subprocess.PIPE,text=True)
                    children.append(proc)

    elif a.command == 'gateway':
        role = 'gateway'
        recover()
        RPC.server(URL, Handler).serve_forever()
    elif a.command == 'stop':
        try:
            pid = read(DATA / 'supervisor.pid')
            cmd = pathlib.Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
            if b'supervise' not in cmd or not any(pathlib.Path(os.fsdecode(arg)).resolve() == pathlib.Path(__file__).resolve() for arg in cmd if b'yamichain-devnet' in arg):
                raise RuntimeError('refusing stale/unrelated PID')
            os.kill(pid, signal.SIGTERM)
        except (ProcessLookupError, FileNotFoundError):
            pass
        time.sleep(1)
        print('Stopped; persistent state retained in ' + str(DATA))
    elif a.command == 'status':
        print(json.dumps(http(URL), indent=2))
    elif a.command == 'wallet':
        path = pathlib.Path(a.args[0])
        if path.exists():
            raise SystemExit('wallet already exists')
        w = bridge('key')
        save(path, w)
        print(w['address'])
    elif a.command == 'balance':
        print(json.dumps(balance(a.args[0])))
    elif a.command == 'send':
        print(json.dumps(send(a.args[0], a.args[1], int(a.args[2])), indent=2))
    elif a.command == 'faucet':
        print(json.dumps(send(DATA / 'treasury.wallet', read(a.args[0])['address'], int(a.args[1])), indent=2))
    elif a.command == 'fee':
        print(json.dumps(fee_estimate(a.args[0] if a.args else 'Transfer')))
    elif a.command == 'validator-key':
        path=pathlib.Path(a.args[0])
        if path.exists():raise SystemExit('validator key exists')
        key=bridge('validator-key');save(path,key);print(key['consensus'])
    elif a.command == 'register':
        w=read(a.args[0]);v=read(a.args[1]);b=balance(a.args[0])
        action=bridge('registration',owner=w['address'],nonce=b['nonce'],validator=v,chain=policy()['committee']['chain'])
        print(json.dumps(send(a.args[0],v['consensus'],0,action),indent=2))
    elif a.command in ('stake','unstake','exit'):
        name={'stake':'Bond','unstake':'Unbond','exit':'Exit'}[a.command]
        print(json.dumps(send(a.args[0],a.args[1],int(a.args[2]) if len(a.args)>2 else 0,{name:{'validator':list(bytes.fromhex(a.args[1]))}}),indent=2))
    elif a.command == 'join-validator':
        if not LIVE_POS:raise RuntimeError('live PoS profile required')
        slot=int(a.args[1]);key=read(a.args[0])
        if not 4<=slot<len(VALIDATORS):raise RuntimeError('configure a candidate endpoint slot')
        target=DATA/f'validator-key-{slot}.bin'
        fd=os.open(target,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600)
        with os.fdopen(fd,'wb') as f:
            f.write(bytes(key['consensus_secret']+key['transport_secret']));f.flush();os.fsync(f.fileno())
        print(json.dumps({'slot':slot,'consensus':key['consensus'],'endpoint':VALIDATORS[slot]}))
    elif a.command == 'slash':
        action={'Slash':{'left':list(pathlib.Path(a.args[1]).read_bytes()),'right':list(pathlib.Path(a.args[2]).read_bytes())}}
        print(json.dumps(send(a.args[0],read(a.args[0])['address'],0,action),indent=2))
    elif a.command == 'withdraw':
        print(json.dumps(send(a.args[0],read(a.args[0])['address'],0,{'Withdraw':{'ticket':int(a.args[1])}}),indent=2))
    elif a.command == 'history':
        print(json.dumps(http(URL + '/history/' + str(int(a.args[0])))))
